DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
POSTGRES_DB=estuairefleet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# Local e-mail capture: SMTP is handled by Mailpit, UI at http://localhost:8025.
MAILPIT_HOST=mailpit
MAILPIT_SMTP_PORT=1025
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=EstuaireFleet <noreply@estuairefleet.local>
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

ESTUAIREFLEET_OTP_EXPIRY_MINUTES=10
ESTUAIREFLEET_OTP_MAX_ATTEMPTS=5
ESTUAIREFLEET_OTP_RESEND_COOLDOWN_SECONDS=60
ESTUAIREFLEET_OTP_RATE_LIMIT_WINDOW_MINUTES=15
ESTUAIREFLEET_OTP_MAX_SENDS_PER_WINDOW=5
ESTUAIREFLEET_OTP_SESSION_AGE_SECONDS=3600
ESTUAIREFLEET_SIGNAL_TTL_MINUTES=20
ESTUAIREFLEET_SIGNAL_MAX_RENEWALS=3
ESTUAIREFLEET_GEOFENCE_RADIUS_M=500
ESTUAIREFLEET_ALERT_THRESHOLD_DEFAULT=5
ESTUAIREFLEET_ALERT_RESPONSE_TIMEOUT_MINUTES=3
ESTUAIREFLEET_POLL_INTERVAL_SECONDS=5
ESTUAIREFLEET_POSITION_RETENTION_DAYS=30
