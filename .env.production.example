DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=estuairefleet.local
DJANGO_ADMIN_URL=gestion/
POSTGRES_DB=estuairefleet
POSTGRES_USER=estuairefleet
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=EstuaireFleet <noreply@estuairefleet.local>
DJANGO_SECURE_SSL_REDIRECT=True
ESTUAIREFLEET_SIGNAL_TTL_MINUTES=20
ESTUAIREFLEET_SIGNAL_MAX_RENEWALS=3
ESTUAIREFLEET_GEOFENCE_RADIUS_M=500
